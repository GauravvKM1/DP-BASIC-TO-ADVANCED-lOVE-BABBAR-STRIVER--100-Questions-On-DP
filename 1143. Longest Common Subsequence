    int solveMemo(string &s1, string &s2,int i,int j,vector<vector<int>>&dp){
        // base case
        if(i==s1.size() || j==s2.size()){
            return 0;
        }
        if(dp[i][j]!=-1){
            return dp[i][j];
        }
        // processing
        int ans=0;
         if(s1[i]==s2[j]){
            ans= 1+solveMemo(s1,s2,i+1,j+1,dp);
         }
         else{
           ans= 0+max(solveMemo(s1,s2,i,j+1,dp),solveMemo(s1,s2,i+1,j,dp));
         }
         dp[i][j]=ans;
         return dp[i][j];
    }
    int longestCommonSubsequence(string text1, string text2) {
    //    int ans=solveRec(text1,text2,0,0);
    // craete a dp array
       vector<vector<int>>dp(text1.length(),vector<int>(text2.length(),-1));
       int ans=solveMemo(text1,text2,0,0,dp);
       return ans; 
    }
